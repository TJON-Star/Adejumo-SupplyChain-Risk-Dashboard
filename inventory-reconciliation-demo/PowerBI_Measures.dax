/* Agro inventory demo measures. Simulated portfolio data. */
Counted Lines =
CALCULATE ( COUNTROWS ( PhysicalCounts ), PhysicalCounts[CountStatus] = "Counted" )

Pending Count Lines =
CALCULATE ( COUNTROWS ( PhysicalCounts ), PhysicalCounts[CountStatus] = "Pending" )

Variance Lines =
CALCULATE (
    COUNTROWS ( PhysicalCounts ),
    PhysicalCounts[CountStatus] = "Counted",
    PhysicalCounts[VarianceQty] <> 0
)

Variance Line Rate = DIVIDE ( [Variance Lines], [Counted Lines] )

Book Quantity (Counted Lines) =
CALCULATE ( SUM ( PhysicalCounts[BookQtyAtCount] ), PhysicalCounts[CountStatus] = "Counted" )

Physical Quantity (Counted Lines) =
CALCULATE ( SUM ( PhysicalCounts[PhysicalQty] ), PhysicalCounts[CountStatus] = "Counted" )

/* Do not show unfiltered quantity totals: UOMs are mixed (kg, litres, bags, cartons, etc.). */
Signed Variance Value (NGN) =
CALCULATE ( SUM ( PhysicalCounts[VarianceValue_NGN] ), PhysicalCounts[CountStatus] = "Counted" )

Absolute Variance Value (NGN) =
CALCULATE (
    SUMX (
        FILTER ( PhysicalCounts, PhysicalCounts[CountStatus] = "Counted" ),
        ABS ( PhysicalCounts[VarianceValue_NGN] )
    )
)

Open Action Records =
CALCULATE ( COUNTROWS ( ActionLog ), ActionLog[ActionStatus] <> "Closed" )

Closed Action Records =
CALCULATE ( COUNTROWS ( ActionLog ), ActionLog[ActionStatus] = "Closed" )

Action Records = COUNTROWS ( ActionLog )
Action Closure Rate = DIVIDE ( [Closed Action Records], [Action Records] )

Distinct Counted SKUs =
CALCULATE ( DISTINCTCOUNT ( PhysicalCounts[SKU] ), PhysicalCounts[CountStatus] = "Counted" )

/* Opening balances are not period movements. */
Receipts (Qty) =
CALCULATE (
    SUM ( Transactions[QtyIn] ),
    Transactions[RecordType] = "Movement",
    Transactions[TransactionType] = "Receipt"
)

Issues (Qty) =
CALCULATE (
    SUM ( Transactions[QtyOut] ),
    Transactions[RecordType] = "Movement",
    Transactions[TransactionType] = "Issue"
)

Movement Net (Qty; mixed UOM) =
CALCULATE (
    SUM ( Transactions[QtyIn] ) - SUM ( Transactions[QtyOut] ),
    Transactions[RecordType] = "Movement"
)

/* Use movement quantities only at SKU/UOM level; do not aggregate unlike units. */
